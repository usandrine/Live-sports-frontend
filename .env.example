# Environment variables for the frontend app
# Copy this to .env.local for local development
# Add these variables in Vercel dashboard for production

# For local development:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# For production (Vercel -> Render):
NEXT_PUBLIC_API_URL=https://sportz-websockets-i3up.onrender.com
NEXT_PUBLIC_WS_URL=wss://sportz-websockets-i3up.onrender.com/ws
